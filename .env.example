# Shared
NODE_ENV=development
LOG_LEVEL=info
ATPROTO_SERVICE_DID=did:example:patchwork
ATPROTO_PDS_URL=https://bsky.social
# Private/LAN PDS origin for signup
ATPROTO_ACCOUNT_PDS_URL=http://10.0.0.56:3043

# Web
VITE_APP_NAME=Patchwork
VITE_API_BASE_URL=http://localhost:4000
VITE_DATA_MODE=api

# API
API_HOST=0.0.0.0
API_PORT=4000
API_PUBLIC_ORIGIN=http://localhost:5173
# Comma-separated trusted proxy IPs/CIDRs for local development
API_TRUSTED_PROXIES=127.0.0.1
API_DATA_SOURCE=fixture
API_DATABASE_URL=postgresql://patchwork:change-me@localhost:5432/patchwork
API_MAX_PROJECTION_LAG_SECONDS=300
API_RETENTION_INTERVAL_SECONDS=3600
ATPROTO_OAUTH_CLIENT_ID=http://localhost:4000/oauth/client-metadata.json
ATPROTO_OAUTH_REDIRECT_URI=http://127.0.0.1:4000/oauth/callback
# Generate with: openssl rand -base64 32
ATPROTO_SESSION_ENCRYPTION_KEY=

# Indexer
INDEXER_PORT=4100
INDEXER_FIREHOSE_URL=wss://jetstream2.us-east.bsky.network/subscribe

# Moderation worker
MODERATION_PORT=4200
MODERATION_WORKER_CONCURRENCY=2
MODERATION_RETENTION_INTERVAL_SECONDS=3600

# Docker deploy (patchwork.subcult.tv)
PATCHWORK_PUBLIC_ORIGIN=https://patchwork.subcult.tv
# Required by docker-compose.yml in production
API_TRUSTED_PROXIES=10.0.0.0/8

# Required by docker-compose.staging.yml in staging
STAGING_API_TRUSTED_PROXIES=10.0.0.0/8

# Required PMTiles artifact bind mounts for web containers
PATCHWORK_PM_TILES_PATH=/srv/data/patchwork-map/us.pmtiles
STAGING_PATCHWORK_PM_TILES_PATH=/srv/data/patchwork-map/us.pmtiles

# Secrets — generate strong random values for production.
# docker-compose.yml will refuse to start without these.
PATCHWORK_POSTGRES_PASSWORD=change-me
