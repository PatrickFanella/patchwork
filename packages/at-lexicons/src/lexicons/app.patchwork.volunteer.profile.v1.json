{
    "lexicon": 1,
    "id": "app.patchwork.volunteer.profile",
    "revision": "1.2.0",
    "description": "Public volunteer profile and approximate service-area metadata. Private matching and verification state is not authoritative here.",
    "defs": {
        "main": {
            "type": "record",
            "key": "tid",
            "record": {
                "type": "object",
                "required": [
                    "$type",
                    "version",
                    "displayName",
                    "capabilities",
                    "availability",
                    "contactPreference",
                    "createdAt"
                ],
                "properties": {
                    "$type": {
                        "type": "string",
                        "const": "app.patchwork.volunteer.profile"
                    },
                    "version": {
                        "type": "string",
                        "enum": ["1.0.0", "1.1.0", "1.2.0"]
                    },
                    "displayName": { "type": "string", "maxLength": 80 },
                    "bio": { "type": "string", "maxLength": 500 },
                    "capabilities": { "type": "array" },
                    "availability": { "type": "string" },
                    "contactPreference": { "type": "string" },
                    "skills": { "type": "array" },
                    "languages": { "type": "array" },
                    "serviceArea": { "type": "object" },
                    "availabilityWindows": { "type": "array" },
                    "verificationCheckpoints": { "type": "object" },
                    "matchingPreferences": { "type": "object" },
                    "notes": { "type": "string", "maxLength": 500 },
                    "createdAt": { "type": "string", "format": "datetime" },
                    "updatedAt": { "type": "string", "format": "datetime" }
                }
            }
        }
    }
}
